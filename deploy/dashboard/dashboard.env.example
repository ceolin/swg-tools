# Database the dashboard reads. Use a name or IP from the MySQL server
# certificate. Keep ssl_ca as is: it is the path inside the container,
# where ../mysql/certs/ca.pem is mounted.
GHSA_DATABASE_URL=mysql://ghsa:<password>@<host>:3306/ghsa?ssl_ca=/etc/ghsa/ca.pem

# GitHub token used by `ghsa sync` before each render.
SWG_GITHUB_TOKEN=<token>

# When to regenerate, comma-separated HH:MM in TZ.
UPDATE_TIMES=06:00,18:00
TZ=UTC

# Set to false to only render what is already in the database.
SYNC=true
